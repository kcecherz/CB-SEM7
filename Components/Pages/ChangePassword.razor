@page "/konto/haslo"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout AuthLayout
@inject SettingsService Settings
@inject PasswordChangeService Passwords

<PageTitle>Zmiana hasła — Klucznik</PageTitle>

<h1>Zmiana hasła</h1>

@if (Intro is not null)
{
    <p class="banner" role="status">@Intro</p>
}

@if (!string.IsNullOrWhiteSpace(Blad))
{
    <p class="banner banner-bad" role="alert">@ShownError</p>
}

<p>Nowe hasło wpisz dwa razy. Musi różnić się od haseł użytych wcześniej.</p>
<ul>
    <li>Co najmniej @PasswordPolicy.MinimumLength znaków.</li>
    @if (Policy?.RejectSequences == true)
    {
        <li>Bez sekwencji klawiaturowych i ciągów rosnących lub malejących, np. werty, asdf, 1234, abcd.</li>
    }
</ul>

<form method="post" action="/account/zmien-haslo" data-enhance="false">
    <AntiforgeryToken />
    <label>
        Obecne hasło
        <input name="currentPassword" type="password" autocomplete="current-password" maxlength="128" required />
    </label>
    <label>
        Nowe hasło
        <input name="newPassword" type="password" autocomplete="new-password" maxlength="128" required />
    </label>
    <label>
        Powtórz nowe hasło
        <input name="confirmPassword" type="password" autocomplete="new-password" maxlength="128" required />
    </label>
    <button type="submit">Zapisz hasło</button>
    <a href="/wyloguj">Wyloguj</a>
</form>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "blad")]
    private string? Blad { get; set; }

    private SecuritySettings? Policy { get; set; }
    private UserAccount? Account { get; set; }

    private string ShownError =>
        Blad!.Length > 500 ? Blad[..500] : Blad!;

    private string? Intro
    {
        get
        {
            if (Account is null || Policy is null)
                return null;

            if (Account.MustChangePassword || Account.IsOneTimePassword)
                return "Hasło nadane przez administratora trzeba zmienić przy pierwszym logowaniu.";

            if (PasswordRules.IsExpired(Account.PasswordChangedAt, Policy.PasswordValidityDays, DateTimeOffset.UtcNow))
                return "Ważność hasła minęła. Ustaw nowe, podając dotychczasowe.";

            return null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Policy = await Settings.GetAsync();
        if (HttpContext is not null)
            Account = await Passwords.FindAsync(HttpContext.User);
    }
}
